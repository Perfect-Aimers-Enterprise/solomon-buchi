# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Database (MongoDB) ----------
MONGO_URL=

# ---------- Admin area (/admin) ----------
# Use a long passphrase. Session secret must be 32+ random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------- Email (Nodemailer / SMTP) ----------
# Active only when notifications.email.enabled is true in site.config.ts AND these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Fallback recipient if notifications.email.recipient is empty in site.config.ts
NOTIFICATION_EMAIL=
# Optional "From" address (defaults to SMTP_USER)
SMTP_FROM=

# ---------- WhatsApp Business Cloud API ----------
# Active only when notifications.whatsapp.enabled is true in site.config.ts AND these are set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business-initiated messages outside the 24h window require an approved template
# with ONE body variable. Leave empty to send plain text (works inside the 24h window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Paystack (server-side only) ----------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ---------- Stripe (server-side only) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
